PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/growskillstech

# Minimum 32 characters in production
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1d

MASTER_ADMIN_EMAIL=admin@scholarsmediatech.com

# Option A (development): plain password — server compares with timing-safe equality
MASTER_ADMIN_PASSWORD=admin123

# Option B (production): bcrypt hash — if set, MASTER_ADMIN_PASSWORD is ignored
# Generate: npm run hash-password -- "your-strong-password"
# MASTER_ADMIN_PASSWORD_HASH=$2a$10$...

# ==========================================
# BREVO SMTP
# ==========================================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key

# Sender — must be verified in Brevo (domain or Gmail)
EMAIL_FROM="Grow Skills Tech <noreply@growskillstech.com>"

# OTP
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5

CLIENT_URL=http://localhost:5173

# ==========================================
# WHATSAPP CLOUD API (Meta)
# ==========================================
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=1287948581076517
WHATSAPP_BUSINESS_ACCOUNT_ID=2113044355990196
# Secrets — set real values only in the deployment environment, never commit them
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# true = never call Meta; messages are simulated and logged. Set false to send for real.
WHATSAPP_DRY_RUN=true

# Serverless only (Vercel): secret for GET /api/whatsapp/cron/tick, which drains the
# WhatsApp campaign/outbox queue. Long-running servers run the worker in-process.
CRON_SECRET=
