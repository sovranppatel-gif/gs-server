PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/growskillstech

# Minimum 32 characters in production
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1d

MASTER_ADMIN_EMAIL=admin@scholarsmediatech.com

# Option A (development): plain password — server compares with timing-safe equality
MASTER_ADMIN_PASSWORD=admin123

# Option B (production): bcrypt hash — if set, MASTER_ADMIN_PASSWORD is ignored
# Generate: npm run hash-password -- "your-strong-password"
# MASTER_ADMIN_PASSWORD_HASH=$2a$10$...

# ==========================================
# BREVO SMTP
# ==========================================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-brevo-smtp-login@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key

# Sender — must be verified in Brevo (domain or Gmail)
EMAIL_FROM="Grow Skills Tech <noreply@growskillstech.com>"

# OTP
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5

CLIENT_URL=http://localhost:5173

# ==========================================
# WHATSAPP CLOUD API (Meta) ? secrets must be supplied outside Git
# Canonical version; WHATSAPP_API_VERSION remains a backward-compatible alias.
META_GRAPH_API_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_ID=
# Permanent System User token: whatsapp_business_messaging / whatsapp_business_management.
WHATSAPP_ACCESS_TOKEN=
# Meta App Secret, NOT the verify token. Required for all webhook POST requests.
WHATSAPP_APP_SECRET=
# Your own random verify token; same value in Meta webhook setup.
WHATSAPP_VERIFY_TOKEN=
# Optional legacy alias: WHATSAPP_WEBHOOK_VERIFY_TOKEN
# Exact public HTTPS backend callback, not the frontend URL unless reverse-proxied.
WHATSAPP_WEBHOOK_URL=
# Set BOTH consistently: live + false, or dry_run + true. Conflicts block sends.
WHATSAPP_MODE=dry_run
WHATSAPP_DRY_RUN=true
# Kill switch; MongoDB admin settings still control the bot when this is true.
WHATSAPP_AUTO_REPLY_ENABLED=true
WHATSAPP_BUSINESS_TIMEZONE=Asia/Kolkata
WHATSAPP_SEND_TIMEOUT_MS=15000
# Retries apply to explicit provider rejection, never ambiguous timeouts.
WHATSAPP_MAX_RETRIES=3
# Authorized live end-to-end test recipient only (country code, digits).
WHATSAPP_TEST_RECIPIENT=
# Vercel cron / external scheduler Bearer secret; generate a strong random value.
CRON_SECRET=
